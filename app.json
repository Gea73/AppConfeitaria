{
  "expo": {
    "name": "Patisserie",
    "slug": "appconfeitaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo1024.png",
    "scheme": "com.gean73.appconfeitaria",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo1024.png",
      "bundleIdentifier": "com.gean73.appconfeitaria"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fdfdfd",
        "foregroundImage": "./assets/images/logo1024.png",
        "monochromeImage": "./assets/images/logo1024.png"
      },
      "package": "com.gean73.appconfeitaria",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo1024.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Shafarik-Regular.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fdfdfd",
          "image": "./assets/images/logo1024.png",
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac26d591-dd84-4eeb-b70e-100f9176a752"
      }
    },
    "owner": "gean73"
  }
}
